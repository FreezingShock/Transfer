{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The one window gets core IPC + events. No fs, shell, or http plugins are installed at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
