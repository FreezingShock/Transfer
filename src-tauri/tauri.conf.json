{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transfer",
  "version": "0.1.1",
  "identifier": "com.nathan.transfer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Transfer",
        "width": 1180,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#0c0d10",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Sorts your Desktop, Downloads and Documents automatically, on your computer only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
